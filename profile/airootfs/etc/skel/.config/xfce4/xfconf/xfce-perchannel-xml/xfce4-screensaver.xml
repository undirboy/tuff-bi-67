<?xml version="1.0" encoding="UTF-8"?>
<!--
  Screensaver and screen lock are OFF by default.

  In a VM without a real GPU, the screensaver's blank frequently leaves the
  display black and it does not redraw on wake, which looks exactly like a
  crash. On a live/demo image that is pure frustration, so nobody has to wait
  through a lock they never asked for. Re-enable it in Settings -> Screensaver
  if you want it.
-->
<channel name="xfce4-screensaver" version="1.0">
  <property name="saver" type="empty">
    <property name="enabled" type="bool" value="false"/>
    <property name="idle-activation" type="empty">
      <property name="enabled" type="bool" value="false"/>
    </property>
  </property>
  <property name="lock" type="empty">
    <property name="enabled" type="bool" value="false"/>
    <property name="saver-activation" type="empty">
      <property name="enabled" type="bool" value="false"/>
    </property>
  </property>
</channel>
