[Desktop Entry]
Type=Application
Name=Brave Web Browser
GenericName=Web Browser
Comment=Browse the web with Brave (installs on first launch; Firefox if offline)
Exec=undrabyte-brave %U
Icon=brave-browser
Terminal=false
Categories=Network;WebBrowser;
MimeType=x-scheme-handler/http;x-scheme-handler/https;text/html;application/xhtml+xml;
Keywords=web;browser;brave;internet;chrome;chromium;
StartupNotify=true
