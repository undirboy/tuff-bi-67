#!/usr/bin/env bash
#
# undrabyte-net - your network at a glance, and a scan of your OWN LAN.
#
#   undrabyte-net              overview: IPs, gateway, DNS, public IP, open ports
#   undrabyte-net ports        just the services listening on this machine
#   undrabyte-net scan [CIDR]  find live hosts on your LAN (auto-detects /24)
#
# Scan only networks you own or are explicitly authorised to test.

set -uo pipefail

BOLD=$'\033[1m'; RST=$'\033[0m'; ACC=$'\033[38;5;38m'; DIM=$'\033[2m'
have() { command -v "$1" >/dev/null 2>&1; }
sec() { printf '%s== %s ==%s\n' "$ACC$BOLD" "$1" "$RST"; }

# The primary interface and its IPv4 (the one with the default route).
primary_iface() { ip route show default 2>/dev/null | awk '/default/{print $5; exit}'; }
primary_cidr()  {
    local ifc; ifc="$(primary_iface)"
    [ -n "$ifc" ] && ip -o -f inet addr show "$ifc" 2>/dev/null | awk '{print $4; exit}'
}

overview() {
    sec "This machine"
    printf '  hostname   %s\n' "$(hostname 2>/dev/null || echo '?')"
    sec "Interfaces"
    if have ip; then ip -brief addr show 2>/dev/null | sed 's/^/  /'; fi
    sec "Gateway & DNS"
    printf '  gateway    %s\n' "$(ip route show default 2>/dev/null | awk '/default/{print $3; exit}')"
    if have resolvectl; then
        printf '  dns        %s\n' "$(resolvectl dns 2>/dev/null | awk '{$1="";print}' | xargs | tr ' ' ',' )"
    else
        printf '  dns        %s\n' "$(awk '/nameserver/{print $2}' /etc/resolv.conf 2>/dev/null | paste -sd, -)"
    fi
    sec "Public IP"
    if have curl; then
        printf '  public     %s\n' "$(curl -fsS --max-time 6 https://api.ipify.org 2>/dev/null || echo 'unknown (offline?)')"
    fi
    ports
}

ports() {
    sec "Listening services"
    if have ss; then
        ss -tulnH 2>/dev/null | awk '{printf "  %-5s %s\n", $1, $5}' | sort -u
    else
        printf '  (ss not available)\n'
    fi
}

scan() {
    have nmap || { printf 'undrabyte-net: nmap is not installed (sudo pacman -S nmap)\n' >&2; exit 1; }
    local target="${1:-}"
    if [ -z "$target" ]; then
        target="$(primary_cidr)"
        [ -n "$target" ] || { printf 'undrabyte-net: could not auto-detect your LAN; pass a range, e.g. undrabyte-net scan 192.168.1.0/24\n' >&2; exit 1; }
    fi
    printf '%sScanning %s for live hosts (your own network only)…%s\n' "$DIM" "$target" "$RST"
    nmap -sn "$target"
}

case "${1:-overview}" in
    overview|"") overview ;;
    ports)       ports ;;
    scan)        shift; scan "$@" ;;
    -h|--help)   sed -n '3,12p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//' ;;
    *) printf "undrabyte-net: unknown command '%s' (try: overview, ports, scan)\n" "$1" >&2; exit 1 ;;
esac
