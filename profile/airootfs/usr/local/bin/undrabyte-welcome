#!/usr/bin/env bash
# First-run banner: what this image is, how to drive it, and the one rule.
set -uo pipefail

c()  { printf '\033[%sm' "$1"; }
r()  { printf '\033[0m'; }

BOLD=$(c '1'); CYAN=$(c '38;5;38'); DIM=$(c '2'); YEL=$(c '38;5;214'); RST=$(r)

# shellcheck source=/dev/null
version="$(. /usr/lib/os-release 2>/dev/null && echo "${BUILD_ID:-rolling}")"
virt="$(systemd-detect-virt 2>/dev/null || echo unknown)"

cat <<BANNER
${CYAN}${BOLD}
   _   _           _           ___      _
  | | | |_ _  __ _| |_ _ _ __ | _ )_  _| |_ ___
  | |_| | ' \/ _\` |  _| '_/ _\`| _ \ || |  _/ -_)
   \___/|_||_\__,_|\__|_| \__,_|___/\_, |\__\___|
                                    |__/
${RST}${DIM}   UndraByte Linux (${version}) - running under: ${virt}${RST}

 ${BOLD}Get going${RST}
   ${CYAN}undrabyte${RST}            the launcher - everything, in one menu
   ${CYAN}undrabyte-theme${RST}      dark mode (already on) / light mode
   ${CYAN}undrabyte-optimize${RST}   tune for this machine, VM or bare metal
   ${CYAN}undrabyte-vmcheck${RST}    virtualisation, graphics and guest-agent health
   ${CYAN}undrabyte-toolkit${RST}    add BlackArch / AUR security tooling
   ${CYAN}undrabyte-game${RST}       check the gaming stack, launch Steam properly
   ${CYAN}undrabyte-install${RST}    install UndraByte to a disk

 ${BOLD}Docs${RST}
   /usr/local/share/undrabyte/docs   and   github.com/undirboy/tuff-bi-67

 ${YEL}${BOLD}One rule${RST}${YEL}
   The offensive tooling on this image is for systems you own or have
   written permission to test. Scanning, cracking or intercepting anything
   else is a crime in most jurisdictions, whatever the tool makes easy.${RST}

BANNER
