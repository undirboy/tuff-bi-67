#!/usr/bin/env bash
#
# Tune the system for how it is actually running.
#
# A VM and a laptop want opposite things: the VM should stop doing work the
# host already does (I/O scheduling, thermal management, trim timers) and
# spend its cycles on the desktop; bare metal should do all of it. This
# applies the right set, and can undo everything it did.
#
#   hexforge-optimize status          what is applied now, and what is not
#   hexforge-optimize apply           detect the platform and tune for it
#   hexforge-optimize apply vm        force the virtual-machine profile
#   hexforge-optimize apply metal     force the bare-metal profile
#   hexforge-optimize revert          undo everything this tool did
#
#   --dry-run    print every change without making it
#   --aggressive also trade eye-candy for speed (desktop effects, indexing)

set -euo pipefail

readonly STATE_DIR=/var/lib/hexforge
readonly STATE="$STATE_DIR/optimize.state"
readonly SYSCTL=/etc/sysctl.d/98-hexforge-optimize.conf
readonly UDEV=/etc/udev/rules.d/61-hexforge-ioscheduler.rules
readonly JOURNALD=/etc/systemd/journald.conf.d/hexforge-optimize.conf
readonly ENVD=/etc/environment.d/90-hexforge-optimize.conf
readonly ZRAM=/etc/systemd/zram-generator.conf.d/hexforge-optimize.conf

BOLD=$'\033[1m'; DIM=$'\033[2m'; RST=$'\033[0m'
RED=$'\033[31m'; GRN=$'\033[32m'; YEL=$'\033[33m'; CYN=$'\033[36m'

DRY_RUN=0
AGGRESSIVE=0
PROFILE=auto
RESOLVED_PROFILE=auto

die()  { printf '%serror:%s %s\n' "$RED" "$RST" "$*" >&2; exit 1; }
info() { printf '%s==>%s %s\n' "$BOLD" "$RST" "$*"; }
act()  { printf '    %s%s%s\n' "$DIM" "$*" "$RST"; }

# --------------------------------------------------------------- helpers --

write_file() {
    local path=$1
    local content
    content="$(cat)"
    if (( DRY_RUN )); then
        act "write $path"
        printf '%s\n' "$content" | sed 's/^/      | /'
        return 0
    fi
    install -Dm0644 /dev/stdin "$path" <<<"$content"
    act "wrote $path"
    record "file:$path"
}

record() {
    (( DRY_RUN )) && return 0
    mkdir -p "$STATE_DIR"
    grep -qxF "$1" "$STATE" 2>/dev/null || printf '%s\n' "$1" >> "$STATE"
}

unit_exists() {
    [[ -n "$(systemctl list-unit-files --no-legend "$1" 2>/dev/null)" ]]
}

enable_unit() {
    local unit=$1
    unit_exists "$unit" || { act "skip $unit (not installed)"; return 0; }
    systemctl is-enabled --quiet "$unit" 2>/dev/null && { act "$unit already enabled"; return 0; }
    if (( DRY_RUN )); then act "systemctl enable --now $unit"; return 0; fi
    systemctl enable --now "$unit" &>/dev/null || { act "could not enable $unit"; return 0; }
    act "enabled $unit"
    record "enabled:$unit"
}

disable_unit() {
    local unit=$1
    unit_exists "$unit" || return 0
    systemctl is-enabled --quiet "$unit" 2>/dev/null || return 0
    if (( DRY_RUN )); then act "systemctl disable --now $unit"; return 0; fi
    systemctl disable --now "$unit" &>/dev/null || return 0
    act "disabled $unit"
    record "disabled:$unit"
}

# ------------------------------------------------------------- detection --

detect_platform() {
    local virt
    virt="$(systemd-detect-virt 2>/dev/null || echo none)"
    [[ $virt == none ]] && echo metal || echo vm
}

ram_gb()   { awk '/MemTotal/{printf "%d", $2/1048576}' /proc/meminfo; }
has_battery() { compgen -G '/sys/class/power_supply/BAT*' >/dev/null; }
is_intel() { grep -qi 'GenuineIntel' /proc/cpuinfo; }

rotational_disks() {
    local d
    for d in /sys/block/[sh]d[a-z] /sys/block/vd[a-z] /sys/block/nvme*; do
        [[ -r "$d/queue/rotational" ]] || continue
        printf '%s %s\n' "$(basename "$d")" "$(<"$d/queue/rotational")"
    done
}

# ------------------------------------------------------------- the knobs --

common_sysctl() {
    local ram; ram=$(ram_gb)
    local swappiness=10 cache_pressure=50
    # On a small box, swapping to compressed RAM beats reclaiming page cache.
    (( ram <= 6 )) && { swappiness=100; cache_pressure=75; }

    write_file "$SYSCTL" <<EOF
# Generated by hexforge-optimize ($RESOLVED_PROFILE profile, ${ram} GB RAM).
# Remove with: hexforge-optimize revert

vm.swappiness = $swappiness
vm.vfs_cache_pressure = $cache_pressure
vm.dirty_ratio = 10
vm.dirty_background_ratio = 5

# Desktop responsiveness under load.
kernel.sched_autogroup_enabled = 1

# Plenty of inotify watches: editors, file managers and IDEs all want them.
fs.inotify.max_user_watches = 524288
fs.inotify.max_user_instances = 1024
EOF
}

tune_zram() {
    local ram size
    ram=$(ram_gb)
    if   (( ram <= 4 ));  then size="ram"
    elif (( ram <= 8 ));  then size="min(ram, 4096)"
    else                       size="min(ram / 2, 8192)"
    fi
    write_file "$ZRAM" <<EOF
# Generated by hexforge-optimize (${ram} GB RAM).
[zram0]
zram-size = $size
compression-algorithm = zstd
swap-priority = 100
EOF
}

tune_journald() {
    local storage=$1 maxuse=$2
    write_file "$JOURNALD" <<EOF
# Generated by hexforge-optimize.
[Journal]
Storage=$storage
SystemMaxUse=$maxuse
RuntimeMaxUse=64M
EOF
}

# ------------------------------------------------------------ vm profile --

apply_vm() {
    info "virtual machine profile"

    common_sysctl
    tune_zram

    # The host already schedules the physical device; a second scheduler in
    # the guest only adds latency.
    write_file "$UDEV" <<'EOF'
# Generated by hexforge-optimize (VM profile).
# The hypervisor schedules the real device; the guest should not re-order.
ACTION=="add|change", KERNEL=="vd[a-z]", ATTR{queue/scheduler}="none"
ACTION=="add|change", KERNEL=="nvme[0-9]n[0-9]", ATTR{queue/scheduler}="none"
ACTION=="add|change", KERNEL=="sd[a-z]", ATTR{queue/rotational}=="0", ATTR{queue/scheduler}="mq-deadline"
EOF

    # Logs on a live/ephemeral guest are not worth the writes.
    tune_journald volatile 100M

    # Software rendering wants every core it can get; llvmpipe defaults to 1.
    write_file "$ENVD" <<EOF
# Generated by hexforge-optimize (VM profile).
# llvmpipe/lavapipe use one thread unless told otherwise, which is the
# difference between a sluggish desktop and a usable one without a GPU.
LP_NUM_THREADS=$(nproc)
# Skip driver-side error checking that buys nothing on a virtual adapter.
MESA_NO_ERROR=1
EOF

    info "services the host already handles"
    disable_unit thermald.service
    disable_unit tlp.service
    disable_unit power-profiles-daemon.service
    disable_unit irqbalance.service
    disable_unit smartd.service
    disable_unit lvm2-monitor.service
    disable_unit NetworkManager-wait-online.service

    info "services the guest does want"
    enable_unit fstrim.timer          # discard propagates to the host image
    enable_unit systemd-oomd.service

    (( AGGRESSIVE )) && trim_desktop
}

# --------------------------------------------------------- metal profile --

apply_metal() {
    info "bare-metal profile"

    common_sysctl
    tune_zram
    tune_journald persistent 500M

    # Real hardware: schedule for the device that is actually there.
    write_file "$UDEV" <<'EOF'
# Generated by hexforge-optimize (bare-metal profile).
# NVMe is fast and deep-queued: no scheduler. Spinning rust wants BFQ.
ACTION=="add|change", KERNEL=="nvme[0-9]n[0-9]", ATTR{queue/scheduler}="none"
ACTION=="add|change", KERNEL=="sd[a-z]", ATTR{queue/rotational}=="1", ATTR{queue/scheduler}="bfq"
ACTION=="add|change", KERNEL=="sd[a-z]", ATTR{queue/rotational}=="0", ATTR{queue/scheduler}="mq-deadline"
EOF

    write_file "$ENVD" <<'EOF'
# Generated by hexforge-optimize (bare-metal profile).
# Let the real driver decide; no software-rendering overrides here.
EOF

    info "hardware services"
    enable_unit fstrim.timer
    enable_unit systemd-oomd.service
    is_intel && enable_unit thermald.service
    [[ $(nproc) -ge 4 ]] && enable_unit irqbalance.service
    if has_battery; then
        act "battery detected: this is a laptop"
        enable_unit power-profiles-daemon.service
    fi

    info "guest agents are not needed here"
    disable_unit qemu-guest-agent.service
    disable_unit vboxservice.service
    disable_unit vmtoolsd.service
    disable_unit vmware-vmblock-fuse.service

    (( AGGRESSIVE )) && trim_desktop
}

# ---------------------------------------------------------- aggressive --

trim_desktop() {
    info "aggressive: trading background work for responsiveness"

    # KDE's file indexer is the single biggest idle cost on a small machine.
    local baloo=""
    command -v balooctl6 &>/dev/null && baloo=balooctl6
    [[ -z $baloo ]] && command -v balooctl &>/dev/null && baloo=balooctl
    if [[ -n $baloo ]]; then
        if (( DRY_RUN )); then
            act "$baloo disable"
        else
            runuser -u "${SUDO_USER:-root}" -- "$baloo" disable &>/dev/null || true
            act "disabled baloo file indexing"
            record "baloo:disabled"
        fi
    fi

    disable_unit packagekit.service
    disable_unit man-db.timer
    disable_unit updatedb.timer
    disable_unit plocate-updatedb.timer
}

# ------------------------------------------------------------- commands --

cmd_status() {
    local detected; detected="$(detect_platform)"
    printf '%sHexForge optimisation%s\n\n' "$BOLD" "$RST"
    printf '  %-22s %s\n' "platform" "$detected ($(systemd-detect-virt 2>/dev/null || echo bare-metal))"
    printf '  %-22s %s GB\n' "memory" "$(ram_gb)"
    printf '  %-22s %s\n' "cpus" "$(nproc)"
    printf '  %-22s %s\n' "battery" "$(has_battery && echo yes || echo no)"

    printf '\n  %-22s ' "applied profile"
    if [[ -r $STATE ]]; then
        printf '%s%s%s\n' "$GRN" "$(grep -m1 '^profile:' "$STATE" 2>/dev/null | cut -d: -f2- || echo unknown)" "$RST"
    else
        printf '%snone - run: sudo hexforge-optimize apply%s\n' "$YEL" "$RST"
    fi

    printf '\n%sBlock devices%s\n' "$BOLD" "$RST"
    local dev rot sched
    while read -r dev rot; do
        sched="$(sed -n 's/.*\[\(.*\)\].*/\1/p' "/sys/block/$dev/queue/scheduler" 2>/dev/null || echo n/a)"
        printf '  %-10s %-12s scheduler: %s\n' "$dev" \
            "$( [[ $rot == 1 ]] && echo rotational || echo solid-state )" "$sched"
    done < <(rotational_disks)

    printf '\n%sMemory%s\n' "$BOLD" "$RST"
    local zsize
    zsize="$(awk '/zram0/{printf "%.0f MB", $3/1024}' /proc/swaps 2>/dev/null)"
    if [[ -n $zsize ]]; then
        printf '  %-22s %s\n' "zram swap" "$zsize"
    elif [[ -e /dev/zram0 ]]; then
        printf '  %-22s %spresent but not swapped on%s\n' "zram swap" "$YEL" "$RST"
    else
        printf '  %-22s %snot active%s\n' "zram swap" "$YEL" "$RST"
    fi
    printf '  %-22s %s\n' "vm.swappiness" "$(sysctl -n vm.swappiness)"

    if [[ -r $STATE ]]; then
        printf '\n%sChanges on record%s (revert with: sudo hexforge-optimize revert)\n' "$BOLD" "$RST"
        sed 's/^/  /' "$STATE"
    fi
}

cmd_apply() {
    [[ $EUID -eq 0 || $DRY_RUN == 1 ]] || die "run as root: sudo hexforge-optimize apply"

    local target=$PROFILE
    [[ $target == auto ]] && target="$(detect_platform)"
    RESOLVED_PROFILE=$target

    printf '%sTuning for: %s%s%s%s\n\n' "$BOLD" "$CYN" "$target" "$RST" \
        "$( (( DRY_RUN )) && printf ' (dry run - nothing will change)' )"

    case $target in
        vm)    apply_vm ;;
        metal) apply_metal ;;
        *)     die "unknown profile '$target' (auto, vm, metal)" ;;
    esac

    if (( ! DRY_RUN )); then
        mkdir -p "$STATE_DIR"
        sed -i '/^profile:/d' "$STATE" 2>/dev/null || true
        printf 'profile:%s%s\n' "$target" "$( (( AGGRESSIVE )) && printf ' (aggressive)')" >> "$STATE"
        info "reloading"
        sysctl --system &>/dev/null || true
        udevadm control --reload &>/dev/null || true
        udevadm trigger --subsystem-match=block &>/dev/null || true
        systemctl daemon-reload &>/dev/null || true
        systemctl restart systemd-journald &>/dev/null || true
    fi

    printf '\n%sDone.%s Some changes (zram sizing, environment) take effect at next boot.\n' "$GRN" "$RST"
    printf 'Check with: %shexforge-optimize status%s\n' "$DIM" "$RST"
}

cmd_revert() {
    [[ $EUID -eq 0 || $DRY_RUN == 1 ]] || die "run as root: sudo hexforge-optimize revert"
    [[ -r $STATE ]] || { info "nothing on record - nothing to revert"; return 0; }

    info "undoing recorded changes"
    local line kind value
    while IFS= read -r line; do
        kind=${line%%:*}; value=${line#*:}
        case $kind in
            file)
                if (( DRY_RUN )); then act "rm $value"
                else rm -f "$value"; act "removed $value"; fi ;;
            enabled)
                if (( DRY_RUN )); then act "systemctl disable $value"
                else systemctl disable --now "$value" &>/dev/null || true; fi ;;
            disabled)
                if (( DRY_RUN )); then act "systemctl enable $value"
                else systemctl enable --now "$value" &>/dev/null || true; fi ;;
            baloo)    act "re-enable file indexing yourself with: balooctl enable" ;;
            profile)  ;;
        esac
    done < "$STATE"

    if (( ! DRY_RUN )); then
        rm -f "$STATE"
        sysctl --system &>/dev/null || true
        udevadm control --reload &>/dev/null || true
        systemctl daemon-reload &>/dev/null || true
    fi
    printf '\n%sReverted.%s Reboot to drop the remaining kernel-level settings.\n' "$GRN" "$RST"
}

usage() {
    sed -n '3,18p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'
}

# ----------------------------------------------------------------- main --

CMD=""
while [[ $# -gt 0 ]]; do
    case $1 in
        status|apply|revert) CMD=$1; shift ;;
        auto|vm|metal)       PROFILE=$1; shift ;;
        --dry-run)           DRY_RUN=1; shift ;;
        --aggressive)        AGGRESSIVE=1; shift ;;
        -h|--help)           usage; exit 0 ;;
        *)                   usage >&2; die "unknown argument: $1" ;;
    esac
done

case ${CMD:-status} in
    status) cmd_status ;;
    apply)  cmd_apply ;;
    revert) cmd_revert ;;
esac
