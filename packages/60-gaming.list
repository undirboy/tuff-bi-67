# Gaming stack. Requires [multilib]; the build script enables it automatically.

steam
lutris
gamemode
lib32-gamemode
gamescope
mangohud
lib32-mangohud

# Wine / Proton runtime
wine
wine-mono
wine-gecko
winetricks
vkd3d
lib32-vkd3d
lib32-mesa
lib32-vulkan-icd-loader
lib32-vulkan-swrast
lib32-vulkan-virtio

# open driver stack for bare metal (harmless inside a VM)
vulkan-radeon
lib32-vulkan-radeon
vulkan-intel
lib32-vulkan-intel

# audio
pipewire
pipewire-alsa
pipewire-pulse
pipewire-jack
lib32-pipewire
wireplumber
alsa-utils
pavucontrol

# controllers
game-devices-udev
sdl2-compat
lib32-sdl2-compat

# emulation & a few FOSS titles to prove the stack works
retroarch
retroarch-assets-xmb
supertuxkart
0ad
wesnoth
