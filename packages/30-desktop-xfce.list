# XFCE edition: lighter, happier on 2 vCPU / 2 GB VMs.

xfce4
xfce4-goodies
lightdm
lightdm-gtk-greeter
lightdm-gtk-greeter-settings

# The X server itself. LightDM and XFCE are X clients - without a display
# server there is nothing to draw to, so the screen stays blank. The
# modesetting driver built into xorg-server drives virtio-gpu, QXL and plain
# VGA in a VM (and Intel/AMD/nouveau on bare metal), so no per-GPU video
# driver is needed. xf86-input-libinput is what gives X a working mouse and
# keyboard; it is only an optional dependency of xorg-server, so name it.
xorg-server
xorg-xinit
xorg-xauth
xf86-input-libinput

# themes: the dark defaults undrabyte-theme switches between
breeze-gtk
breeze-icons
gnome-themes-extra
papirus-icon-theme
# A Windows-like desktop needs no terminal for everyday tasks. These make
# the file manager (Thunar, from the xfce4 group) behave the way people
# expect: right-click "Create Folder", auto-mounting USB sticks and phones,
# thumbnails, and double-click to extract archives.
yad                    # GTK dialogs: powers the graphical Software installer
ttf-liberation         # metric-compatible with Arial/Times/Courier (Office/web)
xdg-user-dirs          # standard Documents/Downloads/Pictures folders
thunar                 # the file manager (explicit, not just via the group)
thunar-volman          # auto-mount removable drives on insert
thunar-archive-plugin  # right-click extract/create archives
tumbler                # thumbnails for images, PDFs, video
gvfs                   # mount USB, phones (MTP), network shares
gvfs-mtp               # Android phones over USB
gvfs-smb               # Windows/SMB network shares
udisks2                # the mounting backend
file-roller            # archive manager (zip, 7z, tar...)
xarchiver              # lightweight archive GUI Thunar calls
xfce4-whiskermenu-plugin  # a searchable Start-menu-style app launcher
xfce4-screenshooter    # PrintScreen screenshots
xfce4-clipman-plugin   # clipboard history, like Win+V
xfce4-pulseaudio-plugin # volume control in the tray
xfce4-notifyd          # desktop notifications
xfce4-taskmanager      # a graphical Task Manager
galculator             # a calculator
xfce4-screensaver      # lock screen and screensaver
xfce4-power-manager    # battery/brightness, lid actions
sound-theme-freedesktop # UI click/alert sounds
plymouth               # graphical boot splash (installed systems)
ristretto              # image viewer
mousepad               # simple text editor (Notepad-like)
librsvg                # renders the SVG wallpaper
archlinux-wallpaper    # more wallpapers
network-manager-applet # click-to-connect WiFi/ethernet in the tray
